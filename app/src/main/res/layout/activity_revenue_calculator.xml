<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campus Hub Revenue Model 💼"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#7C3AED"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etGMV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Estimated Monthly GMV (in ₹)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etVerifiedUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of Verified Senior Badges"
            android:inputType="number" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Indian Earnings (₹)"
            android:backgroundTint="#7C3AED"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvRevenueResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>